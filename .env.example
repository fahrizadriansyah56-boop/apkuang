# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend API and PostgreSQL configuration
PORT=4000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/kaspanitia
DATABASE_SSL=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost,capacitor://localhost

# Leave unset when the web app and API are deployed together on Vercel.
# Set to the public HTTPS API origin only when building an APK or a separate client.
VITE_API_BASE_URL=http://localhost:4000
